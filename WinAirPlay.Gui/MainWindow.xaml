<Window x:Class="WinAirPlay.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinAirPlay.Gui"
        Title="WinAirPlay · 把 iPad 投到 Windows" Height="640" Width="1000"
        Icon="pack://application:,,,/Assets/App.ico"
        Background="#16181d" Foreground="#e8e8e8" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0" Background="#1f2228" Height="48">
            <TextBlock Text="WinAirPlay" FontSize="18" FontWeight="Bold" Foreground="#4ea1ff"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBlock Text="把 iPad / iPhone 投到 Windows" FontSize="12" Foreground="#9aa0a6"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button x:Name="OpenLogBtn" Content="打开日志" Width="84" Height="30" DockPanel.Dock="Right"
                    Margin="0,0,8,0" Click="OpenLog_Click" Background="#2a2e36"
                    Foreground="#e8e8e8" BorderThickness="0"/>
            <Button x:Name="SettingsBtn" Content="⚙ 设置" Width="80" Height="30" DockPanel.Dock="Right"
                    Margin="0,0,8,0" Click="SettingsBtn_Click" Background="#2a2e36"
                    Foreground="#e8e8e8" BorderThickness="0"/>
        </DockPanel>

        <!-- Video area: frames are decoded in-process and painted here (no external window) -->
        <Border Grid.Row="1" x:Name="VideoArea" Background="#0b0b0d">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel x:Name="WaitingOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="● 等待 iPad 连接" FontSize="22" Foreground="#cfd3d8" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="13" Foreground="#9aa0a6" HorizontalAlignment="Center"
                               Margin="0,12,0,0" Text="在 iPad 上：控制中心 → 屏幕镜像 → 选择你的电脑"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="#1f2228" Foreground="#cfd3d8" Height="34">
            <StatusBarItem>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="初始化…" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DeviceNameText" Text="设备名：" FontSize="12" Foreground="#9aa0a6"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Settings + log -->
        <StackPanel Grid.Row="3" Background="#1f2228">
            <Expander x:Name="SettingsPanel" Header="设置（修改后自动重启接收器）"
                      Foreground="#cfd3d8" Padding="12" IsExpanded="False">
                <StackPanel Orientation="Vertical" Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="设备名" Width="70" VerticalAlignment="Center"/>
                        <TextBox x:Name="DeviceNameBox" Width="220" Background="#2a2e36" Foreground="#e8e8e8" BorderThickness="0"/>
                        <TextBlock Text="（iPad 上显示的名称）" Foreground="#9aa0a6" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="AirPlay 端口" Width="70" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortBox" Width="90" Background="#2a2e36" Foreground="#e8e8e8" BorderThickness="0"/>
                        <TextBlock Text="MAC 地址" Width="78" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox x:Name="MacBox" Width="150" Background="#2a2e36" Foreground="#e8e8e8" BorderThickness="0"/>
                    </StackPanel>
                    <Button x:Name="SettingsApply" Content="应用并重启" Width="110" Height="28" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Click="SettingsApply_Click" Background="#4ea1ff"
                            Foreground="#ffffff" BorderThickness="0"/>
                </StackPanel>
            </Expander>
            <Expander Header="日志" Foreground="#cfd3d8" Padding="12">
                <TextBox x:Name="LogBox" Height="130" IsReadOnly="True" TextWrapping="Wrap"
                         Background="#0e0f12" Foreground="#b9c0c7" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
